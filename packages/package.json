{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@subtlegradient/reframe-packages",
  "private": true,
  "scripts": {
    "sh": "nix-shell",
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{js,ts,tsx,md}\" | grep -v 'unchanged' || true",
    "outdated": "bunx taze --interactive --recursive",
    "todo:watch": "clear; fswatch -0 TODO.md",
    "todo:check": "git status --porcelain | grep -v 'TODO.md'",
    "todo:commit": "git add TODO.md && git commit -m 'todo++'",
    "todo:commit:no": "git status; github",
    "todo:onchange": "clear; if [ -z \"$(bun run todo:check)\" ]; then bun run todo:commit; else bun run todo:commit:no; fi",
    "todo:bun": "bun run todo:onchange; bun run todo:watch | while read -d '' event; do bun run todo:onchange; done",
    "todo": "bun run todo:bun"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "5.7.2"
  },
  "packageManager": "bun@1.1.38",
  "engines": {
    "bun": ">=1.1",
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "@*/*"
  ],
  "overrides": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  }
}
