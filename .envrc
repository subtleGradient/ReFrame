# Use Nix Flakes for this directory
use flake

# Watch these files for changes - reload environment when they change
watch_file flake.nix
watch_file package.json

# Load nix-direnv if available
if ! has nix_direnv_version || ! nix_direnv_version 2.3.0; then
  source_url "https://raw.githubusercontent.com/nix-community/nix-direnv/2.3.0/direnvrc" "sha256-Dmd+j63L84wuzgyjITIfSxRC912nYpWMX8wR/ZdxHLY="
fi

# Uncomment to automatically allow direnv
# export DIRENV_WARN_TIMEOUT=100s
# direnv_load

# Local overrides
if [ -e .envrc.local ]; then
  source_env .envrc.local
fi