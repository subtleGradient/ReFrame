{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@subtlegradient/reframe-repo",
  "private": true,
  "scripts": {
    "demo-expo": "cd demos/18/expo; bun web",
    "postinstall": "./sh/sh.sh --quiet; cd demos/18; bun i",
    "sh": "nix develop",
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{js,ts,tsx,md}\" | grep -v 'unchanged' || true",
    "outdated": "bunx taze --interactive --recursive",
    "todo:watch": "clear; fswatch -0 TODO.md",
    "todo:check": "git status --porcelain | grep -v 'TODO.md'",
    "todo:commit": "git add TODO.md && git commit -m 'todo++'",
    "todo:commit:no": "git status; github",
    "todo:onchange": "clear; if [ -z \"$(bun run todo:check)\" ]; then bun run todo:commit; else bun run todo:commit:no; fi",
    "todo:bun": "bun run todo:onchange; bun run todo:watch | while read -d '' event; do bun run todo:onchange; done",
    "todo": "bun run todo:bun"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "turbo": "^2.5.3",
    "typescript": "5.8.3"
  },
  "packageManager": "bun@1.2.13",
  "engines": {
    "bun": ">=1.1",
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "demos/19/*",
    "demos/not-18/*",
    "demos/server/*",
    "packages/@*/*"
  ],
  "overrides": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  },
  "config": {
    "ports": {
      "web": 3191,
      "docs": 3192,
      "reframe-expo-demo-1": 3194,
      "demo-server-bun": 3195,
      "demo-server-node": 3197
    }
  },
  "prettier": {
    "semi": false,
    "printWidth": 120,
    "tabWidth": 2,
    "singleQuote": false,
    "bracketSameLine": false,
    "trailingComma": "all",
    "arrowParens": "always",
    "experimentalTernaries": true,
    "jsxSingleQuote": false,
    "proseWrap": "preserve",
    "quoteProps": "preserve",
    "singleAttributePerLine": false
  }
}
