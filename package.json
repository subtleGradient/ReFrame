{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@subtlegradient/reframe-repo",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "postinstall": "./sh.sh",
    "todo:watch": "clear; fswatch -0 TODO.md",
    "todo:check": "git status --porcelain | grep -v 'TODO.md'",
    "todo:commit": "git add TODO.md && git commit -m 'todo++'",
    "todo:commit:no": "git status",
    "todo:onchange": "clear; if [ -z \"$(bun run todo:check)\" ]; then bun run todo:commit; else bun run todo:commit:no; fi",
    "todo": "bun run todo:onchange; bun run todo:watch | while read -d '' event; do bun run todo:onchange; done"
  },
  "devDependencies": {
    "prettier": "^3.2.5",
    "turbo": "^2.3.3",
    "typescript": "5.5.4"
  },
  "engines": {
    "bun": ">=1.1"
  },
  "packageManager": "bun@1.1.38",
  "workspaces": [
    "apps/*",
    "demos/*",
    "packages/*"
  ],
  "config": {
    "tools": {
      "required": {
        "fswatch": {
          "version": "1.17.1",
          "critical": false,
          "channel": "stable"
        },
        "git": {
          "version": "2.0.0",
          "critical": false,
          "url": "https://git-scm.com",
          "channel": "stable"
        },
        "bun": {
          "version": "1.1.38",
          "critical": true,
          "url": "https://bun.sh",
          "channel": "unstable"
        },
        "ollama": {
          "version": "0.5.0",
          "critical": false,
          "url": "https://ollama.ai",
          "channel": "unstable"
        }
      }
    }
  },
  "prettier": {
    "semi": false,
    "printWidth": 100,
    "tabWidth": 2,
    "singleQuote": false,
    "bracketSameLine": false,
    "trailingComma": "all",
    "arrowParens": "always"
  }
}
