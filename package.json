{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@subtlegradient/reframe-repo",
  "private": true,
  "scripts": {
    "postinstall": "watchman watch-del \"$PWD\"; ./sh.sh --quiet; cd packages; bun i; cd ..; cd demos/18; bun i"
  },
  "config": {
    "tools": {
      "required": {
        "watchman": {
          "version": "2024.09.09.00",
          "critical": false,
          "url": "https://facebook.github.io/watchman",
          "channel": "stable"
        },
        "nodejs": {
          "nixPackage": "nodejs_23",
          "versionCheck": "node",
          "command": [
            "node",
            "npm",
            "corepack"
          ],
          "version": "23.0.0",
          "critical": true,
          "url": "https://nodejs.org",
          "channel": "unstable"
        },
        "fswatch": {
          "version": "1.17.1",
          "critical": false,
          "channel": "stable"
        },
        "git": {
          "version": "2.0.0",
          "critical": false,
          "url": "https://git-scm.com",
          "channel": "stable"
        },
        "deno": {
          "version": "2.1.2",
          "critical": false,
          "url": "https://deno.land",
          "channel": "unstable"
        },
        "bun": {
          "version": "1.1.38",
          "critical": true,
          "url": "https://bun.sh",
          "channel": "unstable"
        },
        "ollama": {
          "version": "0.5.0",
          "critical": false,
          "url": "https://ollama.ai",
          "channel": "unstable"
        }
      }
    }
  },
  "prettier": {
    "semi": false,
    "printWidth": 120,
    "tabWidth": 2,
    "singleQuote": false,
    "bracketSameLine": false,
    "trailingComma": "all",
    "arrowParens": "always",
    "experimentalTernaries": true,
    "jsxSingleQuote": false,
    "proseWrap": "preserve",
    "quoteProps": "preserve",
    "singleAttributePerLine": false
  }
}
