{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@subtlegradient/reframe-repo",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "postinstall": "./sh.sh"
  },
  "devDependencies": {
    "prettier": "^3.2.5",
    "turbo": "^2.3.3",
    "typescript": "5.5.4"
  },
  "engines": {
    "bun": ">=1.1"
  },
  "packageManager": "bun@1.1.38",
  "workspaces": [
    "apps/*",
    "demos/*",
    "packages/*"
  ],
  "config": {
    "tools": {
      "required": {
        "fswatch": {
          "version": "1.17.1",
          "critical": false,
          "channel": "stable"
        },
        "git": {
          "version": "2.0.0",
          "critical": false,
          "url": "https://git-scm.com",
          "channel": "stable"
        },
        "bun": {
          "version": "1.1.38",
          "critical": true,
          "url": "https://bun.sh",
          "channel": "unstable"
        },
        "ollama": {
          "version": "0.5.0",
          "critical": false,
          "url": "https://ollama.ai",
          "channel": "unstable"
        }
      }
    }
  }
}
